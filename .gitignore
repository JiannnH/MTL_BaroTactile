# ---------------------------------------------------------------
# CAD source files -- kept locally, not published.
# The repo ships neutral STEP geometry only (see Hardware/README.md).
# ---------------------------------------------------------------

# SolidWorks native (proprietary, needs a licence to open)
*.SLDPRT
*.sldprt
*.SLDASM
*.sldasm
*.SLDDRW
*.slddrw

# Mesh exports -- superseded by STEP, which modern slicers open directly
*.STL
*.stl

# Third-party vendor package model (SOIC24 footprint), not our geometry.
# Kept locally because the SolidWorks assemblies reference it.
Hardware/Mold/SOIC24 wide.stp
